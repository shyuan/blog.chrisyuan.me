{
  "name": "blog-chrisyuan-me",
  "type": "module",
  "version": "5.5.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && bun scripts/postbuild-sitemap.ts && pagefind --site dist && cp -r dist/pagefind public/",
    "build:fast": "astro check && FAST_BUILD=true astro build && bun scripts/postbuild-sitemap.ts && pagefind --site dist && cp -r dist/pagefind public/",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "test": "bun test",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:text": "autocorrect --lint src/data/blog/",
    "lint:desc": "bun scripts/lint-descriptions.ts",
    "fix:text": "autocorrect --fix src/data/blog/",
    "draft": "bun scripts/draft.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.0",
    "astro-embed": "^0.13.1",
    "beautiful-mermaid": "^1.1.3",
    "dayjs": "^1.11.19",
    "lodash.kebabcase": "^4.1.1",
    "rehype-katex": "^7.0.1",
    "remark-collapse": "^0.1.2",
    "remark-math": "^6.0.0",
    "remark-toc": "^9.0.0",
    "satori": "0.19.2",
    "sharp": "^0.34.5",
    "slugify": "^1.6.6",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@pagefind/default-ui": "^1.5.2",
    "@shikijs/transformers": "4.0.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bun": "^1.3.14",
    "@types/lodash.kebabcase": "^4.1.9",
    "@typescript-eslint/parser": "^8.51.0",
    "autocorrect-node": "^2.14.0",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "pagefind": "^1.5.2",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0"
  },
  "lint-staged": {
    "*.{js,ts,astro}": [
      "eslint",
      "prettier --write"
    ],
    "*.md": [
      "autocorrect --fix",
      "prettier --write"
    ],
    "*.{css,mdx,json,yaml,yml}": "prettier --write"
  }
}
