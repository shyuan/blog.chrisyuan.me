---
// 海港自貿區貿易值拐點：八年橫盤 → 2018 貿易戰 / 2019 三大方案 → 2021 拐點
// 資料來源：行政院主計總處，自由貿易港區貿易值（A070105040）
---

<div class="ftz-inflection-container">
  <div class="ftz-canvas-wrap" style="height: 440px;">
    <canvas id="ftz-chart-inflection"></canvas>
  </div>
</div>

<style>
  .ftz-inflection-container {
    padding: 0.5rem 0;
  }
  .ftz-canvas-wrap {
    position: relative;
    width: 100%;
  }
</style>

<script is:inline>
  (function init() {
    if (typeof Chart === "undefined") {
      setTimeout(init, 50);
      return;
    }
    const rootStyles = getComputedStyle(document.documentElement);
    const isDark =
      document.documentElement.getAttribute("data-theme") === "dark";
    const gridColor = isDark ? "rgba(255,255,255,0.12)" : "rgba(0,0,0,0.1)";
    const textColor =
      rootStyles.getPropertyValue("--foreground").trim() ||
      (isDark ? "#c9cacc" : "#282828");

    const years = [
      "2011",
      "2012",
      "2013",
      "2014",
      "2015",
      "2016",
      "2017",
      "2018",
      "2019",
      "2020",
      "2021",
      "2022",
      "2023",
      "2024",
      "2025",
    ];
    const exTaoyuan = [
      1760, 3899, 3887, 3672, 3233, 3488, 3110, 3025, 3147, 2767, 3707, 5333,
      5991, 6356, 8888,
    ];

    const plateauColor = isDark ? "rgba(180,178,169,0.55)" : "#888780";
    const growthColor = "#378ADD";

    const annotationPlugin = {
      id: "ftzInflectionAnnotations",
      afterDraw: function (chart) {
        const ctx = chart.ctx;
        const meta = chart.getDatasetMeta(0);
        const area = chart.chartArea;
        ctx.save();

        const x2013 = meta.data[2].x;
        const x2020 = meta.data[9].x;
        ctx.fillStyle = isDark
          ? "rgba(180,178,169,0.05)"
          : "rgba(136,135,128,0.05)";
        ctx.fillRect(x2013, area.top, x2020 - x2013, area.bottom - area.top);
        ctx.textAlign = "center";
        ctx.fillStyle = isDark
          ? "rgba(200,200,190,0.6)"
          : "rgba(100,99,92,0.7)";
        ctx.font = "400 12px ui-monospace, monospace";
        ctx.fillText(
          "横盤八年 年均 ~3,000 億",
          (x2013 + x2020) / 2,
          area.top + 16
        );

        const x2018 = meta.data[7].x;
        const x2019 = meta.data[8].x;
        const x2021 = meta.data[10].x;
        const midX = (x2018 + x2019) / 2;

        ctx.strokeStyle = isDark
          ? "rgba(226,75,74,0.5)"
          : "rgba(226,75,74,0.5)";
        ctx.setLineDash([3, 3]);
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(x2018, area.top + 28);
        ctx.lineTo(x2018, area.bottom);
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(x2019, area.top + 28);
        ctx.lineTo(x2019, area.bottom);
        ctx.stroke();
        ctx.setLineDash([]);

        const tagX = midX;
        const tagW = 140;
        const tagY = area.top + 30;
        const tagH = 50;

        ctx.fillStyle = isDark
          ? "rgba(226,75,74,0.18)"
          : "rgba(226,75,74,0.08)";
        if (typeof ctx.roundRect === "function") {
          ctx.beginPath();
          ctx.roundRect(tagX - tagW / 2, tagY, tagW, tagH, 6);
          ctx.fill();
        } else {
          ctx.fillRect(tagX - tagW / 2, tagY, tagW, tagH);
        }
        ctx.strokeStyle = isDark
          ? "rgba(226,75,74,0.35)"
          : "rgba(226,75,74,0.2)";
        ctx.lineWidth = 0.5;
        if (typeof ctx.roundRect === "function") {
          ctx.beginPath();
          ctx.roundRect(tagX - tagW / 2, tagY, tagW, tagH, 6);
          ctx.stroke();
        } else {
          ctx.strokeRect(tagX - tagW / 2, tagY, tagW, tagH);
        }

        ctx.fillStyle = isDark ? "#F09595" : "#A32D2D";
        ctx.font = "500 12px ui-monospace, monospace";
        ctx.textAlign = "center";
        ctx.fillText("2018 美中貿易戰", tagX, tagY + 19);
        ctx.fillText("2019 三大方案啟動", tagX, tagY + 38);

        const arrowStartY = tagY + tagH + 8;
        const arrowEndX = x2021;
        const arrowY = arrowStartY + 4;

        ctx.strokeStyle = isDark
          ? "rgba(55,138,221,0.6)"
          : "rgba(55,138,221,0.55)";
        ctx.lineWidth = 1.5;
        ctx.setLineDash([4, 3]);
        ctx.beginPath();
        ctx.moveTo(tagX, arrowStartY);
        ctx.lineTo(tagX, arrowY);
        ctx.lineTo(arrowEndX, arrowY);
        ctx.stroke();
        ctx.setLineDash([]);

        ctx.beginPath();
        ctx.moveTo(arrowEndX, arrowY);
        ctx.lineTo(arrowEndX - 6, arrowY - 4);
        ctx.moveTo(arrowEndX, arrowY);
        ctx.lineTo(arrowEndX - 6, arrowY + 4);
        ctx.stroke();

        ctx.fillStyle = isDark ? "rgba(133,183,235,0.85)" : "#185FA5";
        ctx.font = "400 11px ui-monospace, monospace";
        ctx.textAlign = "center";
        ctx.fillText("建廠 1~2 年", (tagX + arrowEndX) / 2, arrowY - 7);

        ctx.strokeStyle = isDark
          ? "rgba(55,138,221,0.5)"
          : "rgba(55,138,221,0.4)";
        ctx.setLineDash([3, 3]);
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(arrowEndX, arrowY + 6);
        ctx.lineTo(arrowEndX, meta.data[10].y - 8);
        ctx.stroke();
        ctx.setLineDash([]);

        ctx.fillStyle = growthColor;
        ctx.beginPath();
        ctx.arc(arrowEndX, meta.data[10].y, 5, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = isDark ? "#85B7EB" : "#185FA5";
        ctx.font = "500 11px ui-monospace, monospace";
        ctx.textAlign = "left";
        ctx.fillText("2021 拐點", arrowEndX + 10, meta.data[10].y + 4);

        ctx.fillStyle = isDark ? "#85B7EB" : "#185FA5";
        ctx.font = "500 13px ui-monospace, monospace";
        ctx.textAlign = "right";
        ctx.fillText("8,888 億", meta.data[14].x + 2, meta.data[14].y - 10);
        ctx.fillStyle = isDark ? "rgba(133,183,235,0.8)" : "#185FA5";
        ctx.font = "400 11px ui-monospace, monospace";
        ctx.fillText("CAGR +26.3%", meta.data[14].x + 2, meta.data[14].y + 6);

        ctx.restore();
      },
    };

    new Chart(document.getElementById("ftz-chart-inflection"), {
      type: "line",
      data: {
        labels: years,
        datasets: [
          {
            data: exTaoyuan,
            segment: {
              borderColor: function (ctx) {
                return ctx.p1DataIndex <= 9 ? plateauColor : growthColor;
              },
              borderWidth: function (ctx) {
                return ctx.p1DataIndex <= 9 ? 2 : 3.5;
              },
            },
            pointBackgroundColor: exTaoyuan.map(function (_v, i) {
              return i <= 9 ? plateauColor : growthColor;
            }),
            pointBorderColor: exTaoyuan.map(function (_v, i) {
              return i <= 9 ? plateauColor : growthColor;
            }),
            pointRadius: exTaoyuan.map(function (_v, i) {
              return i === 10 ? 0 : i <= 9 ? 3 : 5;
            }),
            tension: 0.3,
            fill: false,
            borderColor: plateauColor,
          },
        ],
      },
      plugins: [annotationPlugin],
      options: {
        responsive: true,
        maintainAspectRatio: false,
        layout: { padding: { top: 10, right: 14 } },
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: function (ctx) {
                return ctx.raw.toLocaleString() + " 億";
              },
            },
          },
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: {
              color: years.map(function (y) {
                return parseInt(y) >= 2021
                  ? isDark
                    ? "#85B7EB"
                    : "#185FA5"
                  : textColor;
              }),
              font: { size: 11 },
              autoSkip: false,
              maxRotation: 45,
            },
          },
          y: {
            grid: { color: gridColor },
            ticks: {
              color: textColor,
              font: { size: 11 },
              callback: function (v) {
                return v.toLocaleString();
              },
            },
            beginAtZero: true,
            max: 10500,
          },
        },
      },
    });
  })();
</script>
