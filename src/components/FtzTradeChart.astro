---
// 自由貿易港區貿易值圖表
// 資料來源：行政院主計總處，自由貿易港區貿易值（A070105040），民國 100-114 年
---

<div class="ftz-chart-container">
  <div class="ftz-kpi-grid">
    <div class="ftz-kpi">
      <div class="ftz-kpi-label">扣除桃園後 2011</div>
      <div class="ftz-kpi-value">1,760 億</div>
    </div>
    <div class="ftz-kpi">
      <div class="ftz-kpi-label">扣除桃園後 2025</div>
      <div class="ftz-kpi-value">8,888 億</div>
    </div>
    <div class="ftz-kpi">
      <div class="ftz-kpi-label">15 年 CAGR</div>
      <div class="ftz-kpi-value">12.2%</div>
    </div>
  </div>

  <div class="ftz-legend">
    <span class="ftz-legend-item"
      ><span class="ftz-legend-swatch" style="background: #378ADD;"
      ></span>扣除桃園空港後合計</span
    >
    <span class="ftz-legend-item"
      ><span
        class="ftz-legend-swatch"
        style="background: rgba(55,138,221,0.15);"></span>桃園空港</span
    >
  </div>

  <div class="ftz-canvas-wrap" style="height: 340px;">
    <canvas id="ftz-chart-stacked"></canvas>
  </div>

  <div class="ftz-legend">
    <span class="ftz-legend-item"
      ><span class="ftz-legend-swatch" style="background: #EF9F27;"
      ></span>臺中港</span
    >
    <span class="ftz-legend-item"
      ><span class="ftz-legend-swatch" style="background: #1D9E75;"
      ></span>臺北港</span
    >
    <span class="ftz-legend-item"
      ><span class="ftz-legend-swatch" style="background: #D4537E;"
      ></span>高雄港</span
    >
    <span class="ftz-legend-item"
      ><span class="ftz-legend-swatch" style="background: #73726c;"
      ></span>基隆港</span
    >
  </div>

  <div class="ftz-canvas-wrap" style="height: 320px;">
    <canvas id="ftz-chart-ports"></canvas>
  </div>
</div>

<style>
  .ftz-chart-container {
    padding: 1rem 0;
  }
  .ftz-kpi-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 1.5rem;
  }
  .ftz-kpi {
    background: var(--muted);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem;
  }
  .ftz-kpi-label {
    font-size: 13px;
    color: var(--foreground);
    opacity: 0.85;
  }
  .ftz-kpi-value {
    font-size: 24px;
    font-weight: 500;
    color: var(--foreground);
  }
  .ftz-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 8px;
    font-size: 12px;
    color: var(--foreground);
    opacity: 0.9;
  }
  .ftz-legend-item {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .ftz-legend-swatch {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 2px;
  }
  .ftz-canvas-wrap {
    position: relative;
    width: 100%;
    margin-bottom: 2rem;
  }
</style>

<script
  is:inline
  src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"
></script>
<script is:inline>
  (function init() {
    if (typeof Chart === "undefined") {
      setTimeout(init, 50);
      return;
    }
    const rootStyles = getComputedStyle(document.documentElement);
    const isDark =
      document.documentElement.getAttribute("data-theme") === "dark";
    const gridColor = isDark ? "rgba(255,255,255,0.12)" : "rgba(0,0,0,0.1)";
    const textColor =
      rootStyles.getPropertyValue("--foreground").trim() ||
      (isDark ? "#c9cacc" : "#282828");
    const years = [
      "2011",
      "2012",
      "2013",
      "2014",
      "2015",
      "2016",
      "2017",
      "2018",
      "2019",
      "2020",
      "2021",
      "2022",
      "2023",
      "2024",
      "2025",
    ];

    const taoyuan = [
      1267, 1120, 1672, 2192, 3030, 3258, 3661, 4449, 6434, 6366, 9233, 12671,
      13403, 23780, 51289,
    ];
    const exTaoyuan = [
      1760, 3899, 3887, 3672, 3233, 3488, 3110, 3025, 3147, 2767, 3707, 5333,
      5991, 6356, 8888,
    ];

    new Chart(document.getElementById("ftz-chart-stacked"), {
      type: "bar",
      data: {
        labels: years,
        datasets: [
          {
            label: "扣除桃園",
            data: exTaoyuan,
            backgroundColor: "#378ADD",
            borderRadius: 3,
            order: 1,
          },
          {
            label: "桃園空港",
            data: taoyuan,
            backgroundColor: isDark
              ? "rgba(55,138,221,0.2)"
              : "rgba(55,138,221,0.15)",
            borderRadius: 3,
            order: 2,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          title: {
            display: true,
            text: "扣除桃園空港後，其餘港區合計 vs 桃園 (億 NTD)",
            color: textColor,
            font: { size: 14, weight: "500" },
            padding: { bottom: 16 },
          },
          tooltip: {
            callbacks: {
              label: function (ctx) {
                return (
                  ctx.dataset.label + ": " + ctx.raw.toLocaleString() + " 億"
                );
              },
            },
          },
        },
        scales: {
          x: {
            stacked: false,
            grid: { display: false },
            ticks: { color: textColor, font: { size: 11 }, maxRotation: 45 },
          },
          y: {
            grid: { color: gridColor },
            ticks: {
              color: textColor,
              font: { size: 11 },
              callback: function (v) {
                return v >= 10000
                  ? (v / 10000).toFixed(1) + "兆"
                  : v.toLocaleString();
              },
            },
            beginAtZero: true,
          },
        },
      },
    });

    const keelung = [
      48, 129, 141, 154, 65, 26, 50, 46, 30, 12, 10, 19, 17, 10, 9,
    ];
    const kaohsiung = [
      209, 300, 286, 411, 599, 695, 813, 809, 908, 713, 785, 967, 1016, 1618,
      1684,
    ];
    const taichung = [
      910, 2905, 2711, 2168, 1673, 2064, 1686, 1537, 1536, 1309, 2020, 3363,
      3759, 3253, 4762,
    ];
    const taipei = [
      593, 565, 749, 939, 897, 698, 552, 625, 657, 708, 888, 975, 1183, 1466,
      2423,
    ];

    new Chart(document.getElementById("ftz-chart-ports"), {
      type: "line",
      data: {
        labels: years,
        datasets: [
          {
            label: "臺中港",
            data: taichung,
            borderColor: "#EF9F27",
            backgroundColor: "transparent",
            tension: 0.3,
            pointRadius: 4,
            borderWidth: 2.5,
          },
          {
            label: "臺北港",
            data: taipei,
            borderColor: "#1D9E75",
            backgroundColor: "transparent",
            tension: 0.3,
            pointRadius: 4,
            borderWidth: 2,
          },
          {
            label: "高雄港",
            data: kaohsiung,
            borderColor: "#D4537E",
            backgroundColor: "transparent",
            tension: 0.3,
            pointRadius: 4,
            borderWidth: 2,
          },
          {
            label: "基隆港",
            data: keelung,
            borderColor: "#73726c",
            backgroundColor: "transparent",
            tension: 0.3,
            pointRadius: 3,
            borderWidth: 1.5,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          title: {
            display: true,
            text: "各海港自貿區逐年貿易值 (億 NTD)",
            color: textColor,
            font: { size: 14, weight: "500" },
            padding: { bottom: 16 },
          },
          tooltip: {
            callbacks: {
              label: function (ctx) {
                return (
                  ctx.dataset.label + ": " + ctx.raw.toLocaleString() + " 億"
                );
              },
            },
          },
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: { color: textColor, font: { size: 11 }, maxRotation: 45 },
          },
          y: {
            grid: { color: gridColor },
            ticks: {
              color: textColor,
              font: { size: 11 },
              callback: function (v) {
                return v.toLocaleString();
              },
            },
            beginAtZero: true,
          },
        },
      },
    });
  })();
</script>
