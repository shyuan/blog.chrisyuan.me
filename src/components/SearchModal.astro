---
/**
 * SearchModal — Site-wide Pagefind search summoned with ⌘K / Ctrl+K.
 * Terminal-styled overlay with lazy-loaded Pagefind UI.
 */
import "@pagefind/default-ui/css/ui.css";
---

<div
  id="search-modal"
  class="search-modal-overlay"
  role="dialog"
  aria-modal="true"
  aria-label="Search the site"
  aria-hidden="true"
>
  <div class="search-modal-backdrop" data-search-close></div>
  <div class="search-modal-container">
    <div class="search-modal-header">
      <div class="search-modal-title">
        <span class="search-modal-prompt">$</span>
        <span>search</span>
      </div>
      <div class="search-modal-shortcuts">
        <kbd class="kbd-key">⌘</kbd>
        <kbd class="kbd-key">K</kbd>
        <span class="shortcuts-sep">·</span>
        <kbd class="kbd-key">esc</kbd>
        <span class="shortcuts-label">close</span>
      </div>
      <button
        class="search-modal-close"
        data-search-close
        aria-label="Close search"
      >
        <svg
          class="size-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="search-modal-body">
      <div id="modal-pagefind-search"></div>
      <div class="search-empty-state" data-search-empty>
        <p>Type to search for posts, tags, and ideas…</p>
      </div>
    </div>

    <div class="search-modal-footer">
      <div class="footer-hint">
        <kbd class="kbd-key">↵</kbd>
        <span>open</span>
      </div>
      <div class="footer-hint">
        <kbd class="kbd-key">↑↓</kbd>
        <span>navigate</span>
      </div>
      <div class="footer-powered">
        powered by <strong>pagefind</strong>
      </div>
    </div>
  </div>
</div>

<script>
  let cleanupHelper: AbortController | null = null;

  function initSearchModal() {
    if (cleanupHelper) cleanupHelper.abort();
    cleanupHelper = new AbortController();
    const { signal } = cleanupHelper;

    const modal = document.getElementById("search-modal");
    if (!modal) return;

    // Reset any leftover body scroll-lock from a previous page where the
    // modal was open during a browser back/forward navigation
    document.body.style.overflow = "";
    modal.classList.remove("active");
    modal.setAttribute("aria-hidden", "true");

    const emptyState = modal.querySelector(
      "[data-search-empty]"
    ) as HTMLElement | null;
    let pagefindLoaded = false;
    let lastFocused: HTMLElement | null = null;

    function openModal() {
      lastFocused = document.activeElement as HTMLElement | null;
      modal!.classList.add("active");
      modal!.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";

      if (!pagefindLoaded) {
        loadPagefind();
        pagefindLoaded = true;
      }

      setTimeout(() => {
        const input = modal!.querySelector<HTMLInputElement>(
          ".pagefind-ui__search-input"
        );
        input?.focus();
      }, 100);
    }

    function closeModal() {
      modal!.classList.remove("active");
      modal!.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      lastFocused?.focus?.();
      lastFocused = null;
    }

    async function loadPagefind() {
      const container = document.getElementById("modal-pagefind-search");
      if (!container) return;

      if (import.meta.env.DEV) {
        container.innerHTML = `
          <div class="search-modal-dev-warning">
            <p><strong>DEV mode:</strong> Build the project to enable search.</p>
            <code>bun run build</code>
          </div>`;
        return;
      }

      const onIdle =
        window.requestIdleCallback || ((cb: () => void) => setTimeout(cb, 1));
      onIdle(async () => {
        if (signal.aborted) return;
        if (container.querySelector(".pagefind-ui")) return;

        // @ts-expect-error — Missing types for @pagefind/default-ui package.
        const { PagefindUI } = await import("@pagefind/default-ui");

        if (signal.aborted || container.querySelector(".pagefind-ui")) return;

        new PagefindUI({
          element: "#modal-pagefind-search",
          showImages: false,
          showSubResults: true,
        });

        const input = modal!.querySelector<HTMLInputElement>(
          ".pagefind-ui__search-input"
        );
        if (input && emptyState) {
          input.addEventListener(
            "input",
            () => {
              emptyState.style.display = input.value.trim() ? "none" : "";
            },
            { signal }
          );
        }

        if (modal!.classList.contains("active")) {
          setTimeout(() => input?.focus(), 200);
        }
      });
    }

    // Keyboard navigation between results
    modal.addEventListener(
      "keydown",
      (e: KeyboardEvent) => {
        const isInputFocused = document.activeElement?.classList.contains(
          "pagefind-ui__search-input"
        );
        const results = Array.from(
          modal.querySelectorAll<HTMLElement>(".pagefind-ui__result-link")
        );
        const activeEl = document.activeElement as HTMLElement;
        const currentIndex = results.indexOf(activeEl);

        if (e.key === "ArrowDown") {
          e.preventDefault();
          if (isInputFocused && results.length > 0) {
            results[0].focus();
          } else if (currentIndex >= 0 && currentIndex < results.length - 1) {
            results[currentIndex + 1].focus();
          }
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          if (currentIndex > 0) {
            results[currentIndex - 1].focus();
          } else if (currentIndex === 0) {
            const input = modal.querySelector<HTMLInputElement>(
              ".pagefind-ui__search-input"
            );
            input?.focus();
          }
        } else if (e.key === "Enter" && currentIndex >= 0) {
          activeEl.click();
        }
      },
      { signal }
    );

    // Close on backdrop / X button
    modal.querySelectorAll("[data-search-close]").forEach(el => {
      el.addEventListener("click", closeModal, { signal });
    });

    // Close on ESC
    document.addEventListener(
      "keydown",
      (e: KeyboardEvent) => {
        if (e.key === "Escape" && modal.classList.contains("active")) {
          e.preventDefault();
          closeModal();
        }
      },
      { signal }
    );

    // Toggle on ⌘K / Ctrl+K
    document.addEventListener(
      "keydown",
      (e: KeyboardEvent) => {
        if ((e.metaKey || e.ctrlKey) && e.key === "k") {
          e.preventDefault();
          if (modal.classList.contains("active")) {
            closeModal();
          } else {
            openModal();
          }
        }
      },
      { signal }
    );

    // External triggers (Header search button)
    document.querySelectorAll("[data-search-trigger]").forEach(el => {
      el.addEventListener(
        "click",
        (e: Event) => {
          e.preventDefault();
          openModal();
        },
        { signal }
      );
    });

    // Close after clicking a result link
    modal.addEventListener(
      "click",
      (e: Event) => {
        const target = e.target as HTMLElement;
        if (target.closest(".pagefind-ui__result-link")) {
          closeModal();
        }
      },
      { signal }
    );
  }

  document.addEventListener("astro:page-load", initSearchModal);
</script>

<style>
  /* ===== Overlay ===== */
  .search-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: min(10vh, 5rem);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.2s ease,
      visibility 0.2s ease;
  }

  .search-modal-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .search-modal-backdrop {
    position: fixed;
    inset: 0;
    background: color-mix(in srgb, var(--background) 75%, transparent);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  /* ===== Container ===== */
  .search-modal-container {
    position: relative;
    width: 94%;
    max-width: 680px;
    max-height: 78vh;
    display: flex;
    flex-direction: column;
    border-radius: 0.5rem;
    border: 2px solid color-mix(in srgb, var(--accent) 50%, transparent);
    background: color-mix(in srgb, var(--background) 92%, var(--foreground));
    overflow: hidden;
    box-shadow:
      0 4px 12px color-mix(in srgb, var(--background) 50%, transparent),
      0 20px 60px -12px color-mix(in srgb, var(--background) 70%, transparent),
      0 0 60px -12px color-mix(in srgb, var(--accent) 25%, transparent);
    transform: translateY(-12px);
    transition: transform 0.2s ease;
  }

  .search-modal-overlay.active .search-modal-container {
    transform: translateY(0);
  }

  /* ===== Header ===== */
  .search-modal-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    background: color-mix(in srgb, var(--muted) 40%, transparent);
  }

  .search-modal-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--foreground);
    font-family: var(--font-app);
  }

  .search-modal-prompt {
    color: var(--accent);
    font-weight: 700;
  }

  .search-modal-shortcuts {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.7rem;
    color: color-mix(in srgb, var(--foreground) 50%, transparent);
    font-family: var(--font-app);
  }

  .kbd-key {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25rem;
    padding: 0.05rem 0.35rem;
    font-size: 0.65rem;
    font-family: var(--font-app);
    border-radius: 0.25rem;
    border: 1px solid color-mix(in srgb, var(--border) 80%, transparent);
    background: color-mix(in srgb, var(--muted) 60%, transparent);
    color: color-mix(in srgb, var(--foreground) 70%, transparent);
  }

  .shortcuts-sep {
    margin: 0 0.15rem;
    opacity: 0.4;
  }

  .shortcuts-label {
    margin-left: 0.1rem;
  }

  .search-modal-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.625rem;
    height: 1.625rem;
    border-radius: 0.375rem;
    color: color-mix(in srgb, var(--foreground) 50%, transparent);
    transition: all 0.2s ease;
    margin-left: 0.25rem;
    cursor: pointer;
  }

  .search-modal-close:hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }

  /* ===== Body ===== */
  .search-modal-body {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 1.25rem 1.25rem;
  }

  .search-modal-body::-webkit-scrollbar {
    width: 6px;
  }
  .search-modal-body::-webkit-scrollbar-track {
    background: transparent;
  }
  .search-modal-body::-webkit-scrollbar-thumb {
    background: color-mix(in srgb, var(--accent) 30%, transparent);
    border-radius: 10px;
  }

  /* ===== Empty state ===== */
  .search-empty-state {
    padding: 2rem 1rem;
    text-align: center;
    font-family: var(--font-app);
    font-size: 0.825rem;
    color: color-mix(in srgb, var(--foreground) 45%, transparent);
  }

  /* ===== Dev mode warning ===== */
  :global(.search-modal-dev-warning) {
    border: 1px dashed color-mix(in srgb, var(--accent) 50%, transparent);
    border-radius: 0.375rem;
    padding: 0.75rem 1rem;
    background: color-mix(in srgb, var(--muted) 40%, transparent);
    font-size: 0.825rem;
  }

  :global(.search-modal-dev-warning code) {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.25rem 0.5rem;
    background: var(--muted);
    border-radius: 0.25rem;
    font-family: var(--font-app);
    font-size: 0.75rem;
  }

  /* ===== Footer ===== */
  .search-modal-footer {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.6rem 1rem;
    border-top: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    background: color-mix(in srgb, var(--muted) 40%, transparent);
    font-family: var(--font-app);
    font-size: 0.7rem;
    color: color-mix(in srgb, var(--foreground) 45%, transparent);
  }

  .footer-hint {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .footer-powered {
    margin-left: auto;
  }

  .footer-powered strong {
    color: var(--accent);
    font-weight: 600;
  }

  /* ===== Pagefind UI overrides (inside modal) ===== */
  #modal-pagefind-search {
    --pagefind-ui-font: var(--font-app);
    --pagefind-ui-text: var(--foreground);
    --pagefind-ui-background: transparent;
    --pagefind-ui-border: var(--border);
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-tag: var(--muted);
    --pagefind-ui-border-radius: 0.375rem;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-image-border-radius: 4px;
    --pagefind-ui-image-box-ratio: 3 / 2;
  }

  #modal-pagefind-search :global(.pagefind-ui__form::before) {
    background-color: var(--foreground);
  }

  #modal-pagefind-search :global(input) {
    font-weight: 400;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--background) 80%, transparent);
  }

  #modal-pagefind-search :global(input:focus-visible) {
    outline: 1px solid var(--accent);
    border-color: var(--accent);
  }

  #modal-pagefind-search :global(.pagefind-ui__result-title a) {
    color: var(--accent);
    text-decoration-style: dashed;
    text-underline-offset: 4px;
  }

  #modal-pagefind-search :global(.pagefind-ui__result-title a:focus-visible) {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
    text-decoration-line: none;
  }

  #modal-pagefind-search :global(.pagefind-ui__result:last-of-type) {
    border-bottom: 0;
  }

  #modal-pagefind-search
    :global(.pagefind-ui__result-nested .pagefind-ui__result-link:before) {
    font-family: system-ui;
  }
</style>
